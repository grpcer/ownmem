{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ownmem.dev/schemas/archive/daily.schema.json",
  "title": "OwnMem daily telemetry archive",
  "description": "One UTC day of one installation's memory telemetry, reduced to counts and stored beside the expiring event files. Local event files expire after thirty days and never leave the machine that wrote them, so this package is the rolling record of how the system behaved on that day. It carries counts only: no query text, no query digest, no trace or snapshot identifier, no file path, no machine or account name, and no timestamp finer than `day`. Topic names are the single exception, because they are already public in the memory index. v3 drops observation windows, git build identity, and lock hashes; packages live under the gitignored observability tree and are not committed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "installation_id",
    "day",
    "partial_day",
    "stack_version",
    "stack_version_counts",
    "events",
    "retrieval",
    "latency",
    "funnel",
    "ledgers",
    "returned_topics"
  ],
  "properties": {
    "schema": {
      "const": "ownmem-telemetry-day/v3"
    },
    "installation_id": {
      "type": "string",
      "pattern": "^local-[0-9a-f]{12}$",
      "description": "A one-way digest of the machine's local HMAC key. Identifies rows as coming from the same install without identifying the install."
    },
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "partial_day": {
      "type": "boolean",
      "description": "True when the day was still in progress at archive time. Set from the archiving clock, never re-derived by a reader, so every machine agrees on it."
    },
    "stack_version": {
      "type": [
        "string",
        "null"
      ],
      "description": "The recall stack that produced the day: the most common component_version across recall.completed, falling back to all events when the day had no recall."
    },
    "stack_version_counts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "count"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "unreadable",
        "legacy",
        "nested",
        "buckets"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "unreadable": {
          "type": "integer",
          "minimum": 0
        },
        "legacy": {
          "type": "integer",
          "minimum": 0,
          "description": "Rows written before agent attribution existed. Reported apart because those days were genuinely mixed and no honest attribution can be recovered."
        },
        "nested": {
          "type": "integer",
          "minimum": 0,
          "description": "Rows whose environment carried more than one host's markers. Counted apart rather than filed under this build's tie-break."
        },
        "buckets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event",
              "surface",
              "agent",
              "nested",
              "count"
            ],
            "properties": {
              "event": {
                "type": "string"
              },
              "surface": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "agent": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "nested": {
                "type": "boolean"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts",
        "abstained",
        "buckets",
        "legacy_attempts",
        "legacy_abstained",
        "nested_attempts",
        "nested_abstained",
        "abstain_reasons"
      ],
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "description": "Recalls that were graded: session deduplication and legacy abstentions without a recorded reason are excluded, exactly as in the live report."
        },
        "abstained": {
          "type": "integer",
          "minimum": 0
        },
        "buckets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "surface",
              "agent",
              "attempts",
              "abstained"
            ],
            "properties": {
              "surface": {
                "type": "string"
              },
              "agent": {
                "type": "string"
              },
              "attempts": {
                "type": "integer",
                "minimum": 0
              },
              "abstained": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "legacy_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "legacy_abstained": {
          "type": "integer",
          "minimum": 0
        },
        "nested_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "nested_abstained": {
          "type": "integer",
          "minimum": 0
        },
        "abstain_reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "surface",
              "agent",
              "reason",
              "count"
            ],
            "properties": {
              "surface": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "agent": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "samples",
        "total_ms"
      ],
      "properties": {
        "samples": {
          "type": "integer",
          "minimum": 0
        },
        "total_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "samples",
            "p50",
            "p95",
            "p99"
          ],
          "properties": {
            "samples": {
              "type": "integer",
              "minimum": 0
            },
            "p50": {
              "type": [
                "number",
                "null"
              ]
            },
            "p95": {
              "type": [
                "number",
                "null"
              ]
            },
            "p99": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      }
    },
    "funnel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairing_scope",
        "produced_traces",
        "delivered_traces",
        "consumed_traces"
      ],
      "properties": {
        "pairing_scope": {
          "const": "same_utc_day",
          "description": "A recall just before midnight and its delivery just after belong to two packages. Stated rather than left for a reader to infer from a rate that looks slightly low."
        },
        "produced_traces": {
          "type": "integer",
          "minimum": 0
        },
        "delivered_traces": {
          "type": "integer",
          "minimum": 0
        },
        "consumed_traces": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ledgers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feedback",
        "attribution",
        "outcome"
      ],
      "description": "Rows the three permanent ledgers gained on this day. They never expire, so a backfilled day reads them at full fidelity. The three are counted separately and may never be added together.",
      "properties": {
        "feedback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rows",
            "unreadable_rows",
            "by_verdict"
          ],
          "properties": {
            "rows": {
              "type": "integer",
              "minimum": 0
            },
            "unreadable_rows": {
              "type": "integer",
              "minimum": 0
            },
            "by_verdict": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "verdict",
                  "count"
                ],
                "properties": {
                  "verdict": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "attribution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rows",
            "by_label"
          ],
          "properties": {
            "rows": {
              "type": "integer",
              "minimum": 0
            },
            "by_label": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "count"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rows",
            "by_outcome",
            "by_confirmed_by"
          ],
          "properties": {
            "rows": {
              "type": "integer",
              "minimum": 0
            },
            "by_outcome": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "outcome",
                  "count"
                ],
                "properties": {
                  "outcome": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "by_confirmed_by": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "confirmed_by",
                  "count"
                ],
                "properties": {
                  "confirmed_by": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    "returned_topics": {
      "type": "array",
      "description": "The topic names recall returned most often that day. Names, not bodies: they are already public in the memory index beside this file.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "count"
        ],
        "properties": {
          "topic": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
