{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ownmem-embedding-ab/v2",
  "title": "OwnMem local memory embedding A/B report",
  "type": "object",
  "required": [
    "schema", "report_id", "snapshot_id", "provider", "model", "dimensions",
    "weights", "corpus", "metrics", "guard", "diffs"
  ],
  "properties": {
    "schema": { "const": "ownmem-embedding-ab/v2" },
    "report_id": { "$ref": "#/$defs/sha256" },
    "snapshot_id": { "$ref": "#/$defs/sha256" },
    "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
    "model": { "type": "string", "minLength": 1, "maxLength": 256 },
    "component_version": {
      "description": "Recall stack version (MEMORY_RECALL_RUNTIME_VERSION) that produced this report. Deliberately not required: reports written before this field existed stay readable for history, but the enable gate treats a missing or mismatched value as no evidence at all.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "runtime": {
      "type": "object",
      "required": ["a", "b"],
      "properties": {
        "a": { "$ref": "#/$defs/runtimeProfile" },
        "b": { "$ref": "#/$defs/runtimeProfile" }
      },
      "additionalProperties": false
    },
    "cases_sha256": { "$ref": "#/$defs/sha256" },
    "dimensions": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "weights": {
      "type": "object",
      "required": ["a", "b"],
      "properties": {
        "a": { "const": 0 },
        "b": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "corpus": {
      "type": "object",
      "required": ["golden", "negative", "holdout"],
      "properties": {
        "golden": { "$ref": "#/$defs/nonNegativeInteger" },
        "negative": { "$ref": "#/$defs/nonNegativeInteger" },
        "holdout": { "$ref": "#/$defs/nonNegativeInteger" }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": ["golden", "negative", "holdout"],
      "properties": {
        "golden": { "$ref": "#/$defs/rankingComparison" },
        "negative": { "$ref": "#/$defs/negativeComparison" },
        "holdout": {
          "type": "object",
          "required": ["available", "cases", "a", "b"],
          "properties": {
            "available": { "type": "boolean" },
            "cases": { "$ref": "#/$defs/nonNegativeInteger" },
            "a": { "anyOf": [{ "$ref": "#/$defs/rankingMetrics" }, { "type": "null" }] },
            "b": { "anyOf": [{ "$ref": "#/$defs/rankingMetrics" }, { "type": "null" }] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "guard": {
      "type": "object",
      "description": "A tie is not a pass. `recommended_weight_safe` only says nothing regressed, which is all a saturated corpus can ever say; `verdict` states whether this corpus was able to show a gain at all, so an enable path can tell 'proved better' apart from 'could not tell'.",
      "required": [
        "negative_not_worse", "recommended_weight_safe",
        "benefit_measurable", "benefit_observed", "headroom", "gained", "verdict"
      ],
      "properties": {
        "negative_not_worse": { "type": "boolean" },
        "recommended_weight_safe": { "type": "boolean" },
        "benefit_measurable": { "type": "boolean" },
        "benefit_observed": { "type": "boolean" },
        "headroom": {
          "description": "Metrics whose baseline arm is below its ceiling, i.e. the only ones on which arm B could have shown an improvement.",
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "gained": {
          "description": "Metrics with headroom that arm B actually improved. Always a subset of headroom.",
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "verdict": {
          "description": "improves = a metric with room got better. no_change = there was room and nothing moved. uninformative = the baseline is at the ceiling everywhere, so this corpus cannot answer the question. regresses = something got worse. insufficient_evidence = no scored cases.",
          "enum": ["improves", "no_change", "uninformative", "regresses", "insufficient_evidence"]
        }
      },
      "allOf": [
        {
          "description": "A verdict of improves is unreachable without an observed gain, whatever the producer believes.",
          "if": { "properties": { "verdict": { "const": "improves" } }, "required": ["verdict"] },
          "then": { "properties": { "benefit_observed": { "const": true }, "benefit_measurable": { "const": true } } }
        },
        {
          "description": "uninformative means there was no room anywhere; if a metric had room the honest word is no_change.",
          "if": { "properties": { "verdict": { "const": "uninformative" } }, "required": ["verdict"] },
          "then": { "properties": { "benefit_measurable": { "const": false }, "headroom": { "type": "array", "maxItems": 0 } } }
        }
      ],
      "additionalProperties": false
    },
    "diffs": {
      "type": "array",
      "items": { "$ref": "#/$defs/diff" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "runtimeProfile": {
      "type": "object",
      "required": ["version", "engine_lane", "profile_id", "ranking_profile_hash"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "engine_lane": { "const": "canonical" },
        "profile_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ranking_profile_hash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "rankingMetrics": {
      "type": "object",
      "required": ["cases", "recall_at_1", "recall_at_5", "mrr", "by_group"],
      "properties": {
        "cases": { "$ref": "#/$defs/nonNegativeInteger" },
        "recall_at_1": { "$ref": "#/$defs/unit" },
        "recall_at_5": { "$ref": "#/$defs/unit" },
        "mrr": { "$ref": "#/$defs/unit" },
        "by_group": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/groupRankingMetrics" }
        }
      },
      "additionalProperties": false
    },
    "groupRankingMetrics": {
      "type": "object",
      "required": ["cases", "recall_at_1", "recall_at_5", "mrr"],
      "properties": {
        "cases": { "$ref": "#/$defs/nonNegativeInteger" },
        "recall_at_1": { "$ref": "#/$defs/unit" },
        "recall_at_5": { "$ref": "#/$defs/unit" },
        "mrr": { "$ref": "#/$defs/unit" }
      },
      "additionalProperties": false
    },
    "rankingComparison": {
      "type": "object",
      "required": ["a", "b"],
      "properties": {
        "a": { "$ref": "#/$defs/rankingMetrics" },
        "b": { "$ref": "#/$defs/rankingMetrics" }
      },
      "additionalProperties": false
    },
    "negativeMetrics": {
      "type": "object",
      "required": ["cases", "abstained", "abstain_rate", "by_group"],
      "properties": {
        "cases": { "$ref": "#/$defs/nonNegativeInteger" },
        "abstained": { "$ref": "#/$defs/nonNegativeInteger" },
        "abstain_rate": { "$ref": "#/$defs/unit" },
        "by_group": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/groupNegativeMetrics" }
        }
      },
      "additionalProperties": false
    },
    "groupNegativeMetrics": {
      "type": "object",
      "required": ["cases", "abstained", "abstain_rate"],
      "properties": {
        "cases": { "$ref": "#/$defs/nonNegativeInteger" },
        "abstained": { "$ref": "#/$defs/nonNegativeInteger" },
        "abstain_rate": { "$ref": "#/$defs/unit" }
      },
      "additionalProperties": false
    },
    "negativeComparison": {
      "type": "object",
      "required": ["a", "b"],
      "properties": {
        "a": { "$ref": "#/$defs/negativeMetrics" },
        "b": { "$ref": "#/$defs/negativeMetrics" }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": ["rank", "abstained", "returned"],
      "properties": {
        "rank": { "type": ["integer", "null"], "minimum": 1 },
        "abstained": { "type": "boolean" },
        "returned": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" }
        }
      },
      "additionalProperties": false
    },
    "diff": {
      "type": "object",
      "required": ["case_id", "kind", "partition", "group", "expected", "a", "b", "change"],
      "properties": {
        "case_id": { "$ref": "#/$defs/sha256" },
        "kind": { "enum": ["golden", "negative"] },
        "partition": { "enum": ["regression", "challenge", "holdout"] },
        "group": { "type": "string", "minLength": 1, "maxLength": 64 },
        "expected": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" }
        },
        "a": { "$ref": "#/$defs/outcome" },
        "b": { "$ref": "#/$defs/outcome" },
        "change": { "enum": ["improved", "regressed", "unchanged"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
