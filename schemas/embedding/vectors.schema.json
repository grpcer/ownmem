{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ownmem-embedding-vectors/v1",
  "title": "OwnMem local compiled memory embedding vectors",
  "type": "object",
  "required": [
    "schema",
    "provider",
    "model",
    "dimensions",
    "text_recipe",
    "built_at",
    "corpus_snapshot_id",
    "entries"
  ],
  "properties": {
    "schema": { "const": "ownmem-embedding-vectors/v1" },
    "provider": { "enum": ["siliconflow", "cloudflare", "gemini", "jina", "custom"] },
    "model": { "type": "string", "minLength": 1, "maxLength": 256 },
    "dimensions": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "text_recipe": { "const": "v1" },
    "built_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
    "corpus_snapshot_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "entries": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["content_sha256", "vector_b64"],
        "properties": {
          "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "vector_b64": { "type": "string", "minLength": 4, "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
