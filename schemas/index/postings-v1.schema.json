{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ownmem-index.postings-legacy/v1",
  "title": "OwnMem BM25F postings (v1, legacy reader)",
  "type": "object",
  "required": ["schema", "document_count", "field_names", "average_field_lengths", "terms"],
  "properties": {
    "schema": { "const": "ownmem-index.postings/v1" },
    "document_count": { "type": "integer", "minimum": 0 },
    "field_names": {
      "type": "array",
      "prefixItems": [
        { "const": "name" },
        { "const": "hooks" },
        { "const": "description" },
        { "const": "triggers" },
        { "const": "codePath" },
        { "const": "codeSymbol" },
        { "const": "codeTest" },
        { "const": "authorityDocs" },
        { "const": "scopes" },
        { "const": "body" }
      ],
      "items": false,
      "minItems": 10,
      "maxItems": 10
    },
    "average_field_lengths": { "$ref": "#/$defs/lengths" },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "idf", "postings"],
        "properties": {
          "term": { "type": "string", "minLength": 1 },
          "idf": { "type": "number", "minimum": 0 },
          "postings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "prefixItems": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      { "type": "integer", "minimum": 0, "maximum": 9 },
                      { "type": "integer", "minimum": 1 }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "lengths": {
      "type": "object",
      "required": ["name", "hooks", "description", "triggers", "codePath", "codeSymbol", "codeTest", "authorityDocs", "scopes", "body"],
      "properties": {
        "name": { "type": "number", "minimum": 0 },
        "hooks": { "type": "number", "minimum": 0 },
        "description": { "type": "number", "minimum": 0 },
        "triggers": { "type": "number", "minimum": 0 },
        "codePath": { "type": "number", "minimum": 0 },
        "codeSymbol": { "type": "number", "minimum": 0 },
        "codeTest": { "type": "number", "minimum": 0 },
        "authorityDocs": { "type": "number", "minimum": 0 },
        "scopes": { "type": "number", "minimum": 0 },
        "body": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
