{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/grpcer/ownmem/main/schemas/observability/events.schema.json",
  "title": "OwnMem local memory observability event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "event", "recorded_at", "trace_id", "snapshot_id", "process", "payload"],
  "properties": {
    "schema": { "const": "ownmem-observability.event/v2" },
    "event": {
      "enum": [
        "recall.completed",
        "recall.delivered",
        "recall.consumed",
        "feedback.recorded",
        "outcome.recorded",
        "attribution.recorded",
        "index.build",
        "gate.completed",
        "trust.quarantined"
      ]
    },
    "recorded_at": { "type": "string", "format": "date-time" },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "snapshot_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
    "process": { "$ref": "#/$defs/process" },
    "agent": {
      "description": "Which coding agent produced this row. Orthogonal to the payload's `surface`, which is the entry point: `hook` + `codex` and `hook` + `claude` are the same surface asked by two different agents. Optional rather than required because rows written before this field existed carry no honest answer -- those days really were mixed, and inferring an agent for them would be a guess dressed as data, so reports count them as legacy instead. Every producer in this build writes it.",
      "enum": ["claude", "grok", "codex", "unknown"]
    },
    "nested": {
      "description": "More than one host's environment markers were present, which happens when one agent launches another. `agent` still follows the innermost-first order, but this flag lets analysis drop the ambiguous rows rather than trust that ordering.",
      "type": "boolean"
    },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "event": { "const": "recall.completed" } }, "required": ["event"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/recallCompleted" } } }
    },
    {
      "if": { "properties": { "event": { "const": "recall.delivered" } }, "required": ["event"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/recallDelivered" } } }
    },
    {
      "if": { "properties": { "event": { "const": "recall.consumed" } }, "required": ["event"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/recallConsumed" } } }
    },
    {
      "if": { "properties": { "event": { "const": "feedback.recorded" } }, "required": ["event"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/feedbackRecorded" } } }
    },
    {
      "if": { "properties": { "event": { "const": "outcome.recorded" } }, "required": ["event"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/outcomeRecorded" } } }
    },
    {
      "if": { "properties": { "event": { "const": "attribution.recorded" } }, "required": ["event"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/attributionRecorded" } } }
    },
    {
      "if": { "properties": { "event": { "const": "index.build" } }, "required": ["event"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/indexBuild" } } }
    },
    {
      "if": { "properties": { "event": { "const": "gate.completed" } }, "required": ["event"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/gateCompleted" } } }
    },
    {
      "if": { "properties": { "event": { "const": "trust.quarantined" } }, "required": ["event"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/trustQuarantined" } } }
    }
  ],
  "$defs": {
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "runtime_version", "component", "component_version"],
      "properties": {
        "runtime": { "const": "node" },
        "runtime_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "component": { "type": "string", "pattern": "^[a-z0-9.-]+$", "maxLength": 80 },
        "component_version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "nonNegativeNumber": { "type": "number", "minimum": 0 },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "topicName": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$", "maxLength": 160 },
    "topicNames": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/topicName" }
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "pairingStrength": { "enum": ["session", "recent"] },
    "recallCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id", "query_class", "execution", "total_ms", "stage_ms", "channels",
        "rrf_candidates", "abstained", "returned_topics", "estimated_tokens", "cache_hit", "truncated",
        "episode_id"
      ],
      "properties": {
        "surface": { "enum": ["hook", "claude-hook", "cli"] },
        "consumption_eligible": { "type": "boolean" },
        "episode_id": {
          "description": "The user turn this recall happened in, keyed locally. Null for surfaces with no notion of a turn -- a command-line recall has none, and inventing one from a timestamp would make episode membership a guess rather than a fact.",
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "query_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "query_class": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["identifier", "path", "error", "natural", "decision", "mixed"] }
        },
        "execution": { "enum": ["cold", "hot"] },
        "total_ms": { "$ref": "#/$defs/nonNegativeNumber" },
        "stage_ms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "load": { "$ref": "#/$defs/nonNegativeNumber" },
            "plan": { "$ref": "#/$defs/nonNegativeNumber" },
            "rank": { "$ref": "#/$defs/nonNegativeNumber" },
            "context": { "$ref": "#/$defs/nonNegativeNumber" },
            "emit": { "$ref": "#/$defs/nonNegativeNumber" }
          }
        },
        "channels": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" },
          "additionalProperties": { "$ref": "#/$defs/nonNegativeInteger" }
        },
        "rrf_candidates": { "$ref": "#/$defs/nonNegativeInteger" },
        "abstained": { "type": "boolean" },
        "abstain_reason": {
          "description": "Mirrors the recall envelope's abstain.reason exactly. The three blocked-* values were missing until 2026-09-19 and the producer mapped anything unlisted onto no-trusted-candidate, so every trust-gate refusal was recorded as \"nothing matched\", which calls for the opposite response. memory-observability-self-test now walks both enums against each other.",
          "enum": [null, "no-trusted-candidate", "below-threshold", "below-coverage", "below-content-threshold", "blocked-validity", "blocked-applicability", "blocked-risk", "budget-empty", "all-candidates-excluded"]
        },
        "returned_topics": { "$ref": "#/$defs/topicNames" },
        "estimated_tokens": { "$ref": "#/$defs/nonNegativeInteger" },
        "cache_hit": { "type": ["boolean", "null"] },
        "truncated": { "type": "boolean" },
        "dropped_topics": { "$ref": "#/$defs/nonNegativeInteger" },
        "embedding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["active", "latency_ms", "cache_hit", "degraded_reason"],
          "properties": {
            "active": { "const": true },
            "mode": { "enum": ["observe", "weighted"] },
            "rrf_weight": { "type": "number", "minimum": 0, "maximum": 100 },
            "latency_ms": { "$ref": "#/$defs/nonNegativeNumber" },
            "cache_hit": { "type": "boolean" },
            "degraded_reason": {
              "enum": [
                null,
                "auth",
                "quota",
                "network",
                "contract",
                "timeout",
                "config-invalid",
                "artifact-missing",
                "artifact-invalid",
                "artifact-stale",
                "snapshot-unavailable"
              ]
            }
          }
        }
      }
    },
    "recallConsumed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topics", "authority_followed"],
      "properties": {
        "topics": { "$ref": "#/$defs/topicNames" },
        "authority_followed": { "type": ["boolean", "null"] },
        "via": { "enum": ["hook", "claude-hook", "cli", "manual"] },
        "match": { "enum": ["session", "recent", "declared"] }
      }
    },
    "recallDelivered": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "topics"],
      "properties": {
        "surface": { "enum": ["hook", "claude-hook", "cli"] },
        "topics": { "$ref": "#/$defs/topicNames" }
      }
    },
    "feedbackRecorded": {
      "description": "Stream 1, retrieval verdict: did recall return the right thing. Never mixed with the outcome receipt or the weak self-attribution label; each stream owns its own event, file, and denominator.",
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "expected_in_top_k"],
      "properties": {
        "verdict": { "enum": ["correct", "correct_abstain", "wrong", "retrieval_miss", "coverage_gap", "stale", "conflict"] },
        "expected_in_top_k": { "type": ["boolean", "null"] }
      }
    },
    "outcomeRecorded": {
      "description": "Stream 2, outcome receipt: what happened after a memory was used. Only a user or the host may confirm it; `self` is an agent opinion and belongs to attribution.recorded. The payload is an allowlist of enums, booleans and digests -- no prompt, no confirmation text, no file body ever enters telemetry.",
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_id", "outcome", "confirmed_by", "confirmation_sha256", "pairing", "note_present"],
      "properties": {
        "memory_id": { "$ref": "#/$defs/topicName" },
        "outcome": { "enum": ["applied", "helpful_but_not_used", "harmful"] },
        "confirmed_by": { "enum": ["user", "host"] },
        "confirmation_sha256": { "$ref": "#/$defs/sha256" },
        "pairing": { "$ref": "#/$defs/pairingStrength" },
        "note_present": { "type": "boolean" }
      }
    },
    "attributionRecorded": {
      "description": "Stream 3, weak turn-scoped self-attribution. Self-reported and self-selected (only clearly useful or clearly misleading is recorded), so it can never be turned into a rate and must never enter the numerator or denominator of a gate. `basis` is a constant so the stream cannot be silently promoted to explicit feedback.",
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_id", "label", "basis", "scope", "pairing"],
      "properties": {
        "memory_id": { "$ref": "#/$defs/topicName" },
        "label": { "enum": ["useful", "misleading"] },
        "basis": { "const": "self-attribution" },
        "scope": { "const": "turn" },
        "pairing": { "$ref": "#/$defs/pairingStrength" }
      }
    },
    "indexBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "changed_files", "compiled_topics", "reused_topics", "deleted_topics",
        "duration_ms", "snapshot_bytes", "success", "fallback", "previous_snapshot_age_ms", "error_code"
      ],
      "properties": {
        "mode": { "enum": ["full", "incremental"] },
        "changed_files": { "$ref": "#/$defs/nonNegativeInteger" },
        "compiled_topics": { "$ref": "#/$defs/nonNegativeInteger" },
        "reused_topics": { "$ref": "#/$defs/nonNegativeInteger" },
        "deleted_topics": { "$ref": "#/$defs/nonNegativeInteger" },
        "duration_ms": { "$ref": "#/$defs/nonNegativeNumber" },
        "snapshot_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "success": { "type": "boolean" },
        "fallback": { "type": "boolean" },
        "previous_snapshot_age_ms": { "type": ["number", "null"], "minimum": 0 },
        "error_code": { "type": ["string", "null"], "pattern": "^[A-Z0-9_-]+$", "maxLength": 64 }
      }
    },
    "gateCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "status", "errors", "warnings", "duration_ms"],
      "properties": {
        "gate": { "type": "string", "pattern": "^[a-z0-9.-]+$", "maxLength": 80 },
        "status": { "enum": ["passed", "failed"] },
        "errors": { "$ref": "#/$defs/nonNegativeInteger" },
        "warnings": { "$ref": "#/$defs/nonNegativeInteger" },
        "duration_ms": { "$ref": "#/$defs/nonNegativeNumber" }
      }
    },
    "trustQuarantined": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topics", "gates", "reasons", "use_time_revalidation"],
      "properties": {
        "topics": { "$ref": "#/$defs/topicNames" },
        "gates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["validity", "applicability", "risk"] }
        },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 80 }
        },
        "use_time_revalidation": { "const": true }
      }
    }
  }
}
