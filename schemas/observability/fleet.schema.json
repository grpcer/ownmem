{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ownmem.dev/schemas/observability/fleet.schema.json",
  "title": "OwnMem fleet telemetry report",
  "description": "What every machine's committed daily packages say together, and which days none of them covered. Separate from ownmem-report because it answers a different question from a different source: the report reads this machine's expiring event files, this reads the packages in Git. Coverage comes before every total, because a merged number read without its coverage is a number about an unknown fraction of the fleet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "window",
    "telemetry_dir",
    "registry_valid",
    "installations",
    "missing",
    "silent_days",
    "merged"
  ],
  "properties": {
    "schema": { "const": "ownmem-fleet-report/v1" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "from_day", "to_day", "days"],
      "properties": {
        "requested": { "type": ["string", "null"] },
        "from_day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "to_day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "days": { "type": "integer", "minimum": 1 }
      }
    },
    "telemetry_dir": { "type": "string" },
    "registry_valid": {
      "type": "boolean",
      "description": "False when installations.json exists but is unreadable or carries an unknown schema. A machine missing from a broken registry looks the same as one that never ran, so the state is reported rather than absorbed."
    },
    "installations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "installation_id",
          "alias",
          "first_seen",
          "registered",
          "packages_in_window",
          "packages_total",
          "days",
          "missing_days",
          "partial_days",
          "unreleased_delta_days",
          "undetermined_delta_days",
          "stack_versions",
          "released_versions",
          "latency"
        ],
        "properties": {
          "installation_id": { "type": "string", "pattern": "^local-[0-9a-f]{12}$" },
          "alias": {
            "type": ["string", "null"],
            "description": "Null until a person names the machine. Never guessed from the hostname: that would both be wrong and put a machine name in a committed file."
          },
          "first_seen": { "type": ["string", "null"] },
          "registered": { "type": "boolean" },
          "packages_in_window": { "type": "integer", "minimum": 0 },
          "packages_total": { "type": "integer", "minimum": 0 },
          "days": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["day", "present", "partial_day", "events"],
              "properties": {
                "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "present": { "type": "boolean" },
                "partial_day": { "type": ["boolean", "null"] },
                "events": { "type": ["integer", "null"], "minimum": 0 }
              }
            }
          },
          "missing_days": { "type": "array", "items": { "type": "string" } },
          "partial_days": { "type": "array", "items": { "type": "string" } },
          "unreleased_delta_days": { "type": "integer", "minimum": 0 },
          "undetermined_delta_days": {
            "type": "integer",
            "minimum": 0,
            "description": "Days whose package could not decide whether it ran a released tree. Counted apart from the days that answered false, because an unknown is not a no."
          },
          "stack_versions": { "type": "array", "items": { "type": "string" } },
          "released_versions": { "type": "array", "items": { "type": "string" } },
          "latency": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["samples", "worst_p95"],
            "description": "Kept per machine. Percentiles from different machines cannot be added, so the fleet never pools them.",
            "properties": {
              "samples": { "type": "integer", "minimum": 0 },
              "worst_p95": { "type": ["number", "null"] }
            }
          }
        }
      }
    },
    "missing": {
      "type": "array",
      "description": "One row per machine per uncovered day, carrying how many commits landed that day. The commit count is what makes a gap actionable: it says how much work the missing package hid.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["installation_id", "day", "commits"],
        "properties": {
          "installation_id": { "type": "string" },
          "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "commits": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "silent_days": {
      "type": "array",
      "description": "Days on which work landed and not one machine archived anything.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["day", "commits"],
        "properties": {
          "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "commits": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "merged": {
      "type": "object",
      "additionalProperties": false,
      "description": "Counts added across packages. Two installations on the same day are two installations: their counts add, and neither is folded into the other's per-day row.",
      "required": [
        "packages",
        "events",
        "legacy_events",
        "nested_events",
        "unreadable_events",
        "retrieval_attempts",
        "retrieval_abstained",
        "legacy_attempts",
        "legacy_abstained",
        "nested_attempts",
        "nested_abstained",
        "produced_traces",
        "delivered_traces",
        "consumed_traces",
        "feedback_rows",
        "attribution_rows",
        "outcome_rows",
        "event_buckets",
        "retrieval_buckets",
        "abstain_reasons",
        "feedback_verdicts",
        "attribution_labels",
        "outcome_outcomes",
        "latency_mergeable",
        "latency_unmergeable_reason"
      ],
      "properties": {
        "packages": { "type": "integer", "minimum": 0 },
        "events": { "type": "integer", "minimum": 0 },
        "legacy_events": { "type": "integer", "minimum": 0 },
        "nested_events": { "type": "integer", "minimum": 0 },
        "unreadable_events": { "type": "integer", "minimum": 0 },
        "retrieval_attempts": { "type": "integer", "minimum": 0 },
        "retrieval_abstained": { "type": "integer", "minimum": 0 },
        "legacy_attempts": { "type": "integer", "minimum": 0 },
        "legacy_abstained": { "type": "integer", "minimum": 0 },
        "nested_attempts": { "type": "integer", "minimum": 0 },
        "nested_abstained": { "type": "integer", "minimum": 0 },
        "produced_traces": { "type": "integer", "minimum": 0 },
        "delivered_traces": { "type": "integer", "minimum": 0 },
        "consumed_traces": { "type": "integer", "minimum": 0 },
        "feedback_rows": { "type": "integer", "minimum": 0 },
        "attribution_rows": { "type": "integer", "minimum": 0 },
        "outcome_rows": { "type": "integer", "minimum": 0 },
        "event_buckets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event", "surface", "agent", "nested", "count"],
            "properties": {
              "event": { "type": "string" },
              "surface": { "type": ["string", "null"] },
              "agent": { "type": ["string", "null"] },
              "nested": { "type": "boolean" },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "retrieval_buckets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["surface", "agent", "attempts", "abstained"],
            "properties": {
              "surface": { "type": "string" },
              "agent": { "type": "string" },
              "attempts": { "type": "integer", "minimum": 0 },
              "abstained": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "abstain_reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["surface", "agent", "reason", "count"],
            "properties": {
              "surface": { "type": ["string", "null"] },
              "agent": { "type": ["string", "null"] },
              "reason": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "feedback_verdicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["verdict", "count"],
            "properties": {
              "verdict": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "attribution_labels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "count"],
            "properties": {
              "label": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "outcome_outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["outcome", "count"],
            "properties": {
              "outcome": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "latency_mergeable": { "const": false },
        "latency_unmergeable_reason": { "type": "string" }
      }
    }
  }
}
