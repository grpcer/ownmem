{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ownmem-stdio-request/v1",
  "title": "OwnMem memory stdio request",
  "type": "object",
  "required": ["schema", "id", "query"],
  "properties": {
    "schema": { "const": "ownmem-stdio-request/v1" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "query": { "type": "string", "minLength": 1, "maxLength": 512 },
    "tier": { "enum": ["default", "expanded"] },
    "limit": { "type": "integer", "minimum": 1, "maximum": 3 },
    "exclude_memory_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" }
    }
  },
  "additionalProperties": false
}
